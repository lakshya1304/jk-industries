// Super Cleaner - JK Industries
// Database schema.
//
// The provider is set to `postgresql` (production - Vercel + Prisma Postgres).
// For a pure-SQLite local sandbox, change the provider to "sqlite", point
// DATABASE_URL at "file:./dev.db" and run `npm run db:push`.
// The schema intentionally avoids provider-specific features (enums, Json) so it
// works unchanged on both providers.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  sku            String     @unique
  description    String     @default("")
  usage          String     @default("")
  images         String     @default("[]") // JSON array of image URLs
  minOrderQty    Int        @default(1)
  unitsPerCarton Int?
  availability   String     @default("in_stock") // in_stock | out_of_stock | on_request
  featured       Boolean    @default(false)
  active         Boolean    @default(true)
  showPrice      Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  packSizes      PackSize[]

  @@index([active, featured])
}

model PackSize {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String // e.g. "500 ml"
  mrp            Float
  wholesalePrice Float?
  stock          Int? // null = stock not tracked for this pack
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  @@index([productId])
}

model Order {
  id            String       @id @default(cuid())
  reference     String       @unique
  status        String       @default("pending") // pending | confirmed | processing | shipped | delivered | cancelled
  customerName  String
  businessName  String?
  mobile        String
  email         String?
  gstin         String?
  address       String
  city          String
  state         String
  pincode       String
  notes         String?
  internalNotes String? // staff-only notes, never shown to customers
  subtotal      Float
  itemCount     Int
  clientToken   String? // idempotency token to prevent duplicate submissions
  /**
   * When the admin alert (WhatsApp/SMS/email) was successfully delivered for
   * this order. Null means the shop has NOT been alerted automatically, so the
   * dashboard can surface a one-click manual send instead of the admin having
   * to notice on their own.
   */
  adminNotifiedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         OrderItem[]
  events        OrderEvent[]

  @@index([status])
  @@index([createdAt])
}

// Chronological audit trail of every status change and whether the customer
// was notified (WhatsApp/SMS) or the message was left for manual sending.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String // status after this change
  channel   String   @default("none") // whatsapp | sms | none
  notified  Boolean  @default(false) // true when a provider accepted the message
  detail    String? // provider error text, when automatic sending failed
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Line items snapshot product/price data at order time so historical orders
// are unaffected by later catalogue changes.
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  packSizeId    String? // used to reserve/restore stock
  productName   String
  sku           String
  packLabel     String
  unitMrp       Float
  unitWholesale Float?
  quantity      Int
  lineTotal     Float
  /// Units of the underlying pack size this line reserved. Equals `quantity`
  /// for normal lines and `quantity x unitsPerCarton` for carton lines, so
  /// releasing stock is exact even if the product's carton size later changes.
  stockUnits    Int     @default(0)

  @@index([orderId])
}

model Enquiry {
  id           String   @id @default(cuid())
  type         String   @default("contact") // contact | product | dealer | wholesale
  name         String
  businessName String?
  mobile       String
  email        String?
  city         String?
  state        String?
  productSku   String?
  productName  String?
  message      String   @default("")
  status       String   @default("new") // new | contacted | resolved
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Uploaded image bytes.
//
// Vercel Blob is used when `BLOB_READ_WRITE_TOKEN` is set. Serverless hosting
// has no writable filesystem, so without a Blob store there would be nowhere to
// put an upload. This table is that "nowhere": it keeps the bytes in the same
// database the rest of the app already uses, so image uploads work on Vercel
// with no extra account, token, or cost, and GET /api/images/[id] streams them
// back with a long-lived immutable cache header.
//
// The payload is `Bytes` (bytea on PostgreSQL) rather than base64 text: that
// avoids a 33% size overhead and needs no encoding on the way in or out.
model StoredImage {
  id        String   @id @default(cuid())
  /// Original client filename, kept for debugging and download headers.
  filename  String
  /// MIME type as validated on upload; echoed back on read.
  mimeType  String
  /// Size in bytes, so listings can show sizes without loading the blob.
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}
