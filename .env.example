# --- Database ---
# PostgreSQL (production — the schema provider is set to "postgresql").
DATABASE_URL="postgresql://user:password@host:5432/supercleaner?schema=public"
# Zero-setup local sandbox (SQLite): set provider = "sqlite" in prisma/schema.prisma, then:
# DATABASE_URL="file:./dev.db"

# --- Admin authentication ---
# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Site ---
# Public URL of the deployed site (used for sitemap/SEO).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email notifications (optional) ---
# If unset, order notification emails are skipped silently.
# Works with any service that exposes the Resend HTTP API (resend.com, or a
# self-hosted compatible API via EMAIL_API_URL).
EMAIL_API_KEY=""
EMAIL_FROM="orders@supercleaner.in"
# Admin inbox that receives new-order notification emails.
EMAIL_TO="itee9910@gmail.com"
EMAIL_API_URL="https://api.resend.com"

# --- Customer status notifications (optional) ---
# When an admin changes an order status, the customer's phone number is
# notified automatically if either channel below is configured.
#
# 1) WhatsApp — WhatsApp Business Cloud API (Meta), console:
#    https://developers.facebook.com/apps  →  WhatsApp  →  API Setup
#    Both values are required together; without them the dashboard falls back
#    to a one-click prefilled wa.me message the admin sends manually.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
#
# 2) SMS — generic webhook. POSTs { "to": "<digits>", "message": "<text>" }
#    with header `Authorization: Bearer <SMS_API_KEY>`.
#    Adapt sendViaSms() in src/lib/notify.ts for MSG91/Twilio/Twilio payloads.
SMS_API_URL=""
SMS_API_KEY=""
