# --- Database ---
# PostgreSQL (production — the schema provider is set to "postgresql").
DATABASE_URL="postgresql://user:password@host:5432/supercleaner?schema=public"
# Zero-setup local sandbox (SQLite): set provider = "sqlite" in prisma/schema.prisma, then:
# DATABASE_URL="file:./dev.db"

# --- Admin authentication ---
# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Site ---
# Public URL of the deployed site (used for sitemap/SEO).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Search engine verification (optional) ---
# Emitted as a <meta> tag in the document head. Both are injected only when
# set, so no empty verification tag is published before the property exists.
#
# Google Search Console: add a "URL prefix" property for the exact origin in
# NEXT_PUBLIC_SITE_URL, choose the "HTML tag" method, and paste only the
# content value here — NOT the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools (msvalidate.01).
BING_SITE_VERIFICATION=""

# --- Email notifications (optional) ---
# If unset, order notification emails are skipped silently.
# Works with any service that exposes the Resend HTTP API (resend.com, or a
# self-hosted compatible API via EMAIL_API_URL).
EMAIL_API_KEY=""
EMAIL_FROM="orders@supercleaner.in"
# Admin inbox that receives new-order notification emails.
EMAIL_TO="itee9910@gmail.com"
EMAIL_API_URL="https://api.resend.com"

# --- Order notifications (optional) ---
# A new order alerts the shop automatically if any channel below is configured.
# With none configured the admin dashboard offers a one-click WhatsApp link
# containing the same message, and /admin/orders marks the order "Not alerted".

# 1) Admin alert recipient. Optional: when set, new-order alerts go to this
#    number (digits only, country code first) instead of the shop's published
#    WhatsApp number — useful for sending alerts to a personal phone.
WHATSAPP_ADMIN_NUMBER=""

# 2) WhatsApp — WhatsApp Business Cloud API (Meta), console:
#    https://developers.facebook.com/apps  →  WhatsApp  →  API Setup
#    Both values are required together.
#
#    Free-form text is only accepted inside a 24-hour window that the recipient
#    opened by messaging the business number. Outside it Meta returns an error,
#    so for alerts at any hour create and get approval for a message template
#    whose body is a single {{1}} placeholder, then set its name below. The app
#    tries free-form text first and falls back to the template.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
# Template language code as registered with Meta (e.g. en, en_US).
WHATSAPP_TEMPLATE_LANG="en"

# 3) SMS — generic webhook. POSTs { "to": "<digits>", "message": "<text>" }
#    with header `Authorization: Bearer <SMS_API_KEY>`.
#    Adapt sendViaSms() in src/lib/notify.ts for MSG91/Twilio payloads.
SMS_API_URL=""
SMS_API_KEY=""
